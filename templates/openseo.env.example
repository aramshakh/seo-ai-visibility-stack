# OpenSEO (.env) — copy to /root/open-seo-local/.env and fill in.
# Never commit the filled-in file.

# base64("login:password") of your DataForSEO API credentials
DATAFORSEO_API_KEY=

# Shared balance with Elmo: when it runs out, both tools stop.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# >= 32 characters. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# No authentication at all. Only safe because the port is bound to 127.0.0.1
# and reached over an SSH tunnel. NEVER expose this mode to the internet.
AUTH_MODE=local_noauth
PORT=3001

# Only needed for the Search Console card (OAuth). See docs/06-google-search-console.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
