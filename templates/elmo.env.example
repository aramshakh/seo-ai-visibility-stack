# Elmo (.env) — copy to /root/elmo-local/.env and fill in.
# Never commit the filled-in file.

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENROUTER_API_KEY=

# surface:provider:mode. Supported surfaces:
# chatgpt, claude, gemini, perplexity, copilot, grok, deepseek, google-ai-mode, google-ai-overview
SCRAPE_TARGETS=chatgpt:dataforseo:online,google-ai-mode:dataforseo:online,google-ai-overview:dataforseo:online,claude:openrouter:anthropic/claude-sonnet-5:online

# Hours between runs. Default is 24 (7x the cost of weekly). 168 = weekly.
DEFAULT_DELAY_HOURS=168

APP_URL=http://localhost:1515
